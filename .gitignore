# ==========================================
# StudySync Root .gitignore
# Full-Stack Monorepo (Client + Server)
# ==========================================

# 1. Dependencies & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# 2. Environment Variables & Secrets (CRITICAL)
# Exclude all actual credentials, keys, and tokens
.env
.env.*
*.env
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Private keys, certificates & credentials
*.pem
*.key
*.cert
*.crt
*service-account*.json
*credentials*.json

# DO NOT ignore example / template env files
!**/.env.example
!.env.example

# 3. Production Builds & Compilation Outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
dist-ssr/
.next/
.turbo/
*.tsbuildinfo
.eslintcache

# Vite & Bundler Cache
.vite/
**/.vite/
.parcel-cache/

# 4. Database & ORM Artifacts
server/prisma/generated/
prisma/generated/
*.sqlite
*.sqlite3
*.db
*.db-journal

# 5. Local Uploads & Temporary Files
uploads/
**/uploads/
tmp/
temp/
**/.tmp/

# 6. Deployment & Cloud Provider CLI Cache
.vercel/
**/.vercel/
.railway/
**/.railway/
.render/
**/.render/
.serverless/

# 7. Testing & Coverage
coverage/
**/coverage/
.nyc_output/
test-results/
playwright-report/

# 8. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 9. Operating System & Editor Files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
.fleet/
